# Copy this file to .env and fill in your key. .env is git-ignored: never commit it.

# Required for the real backend. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional settings. The values shown are the defaults.
# MEALTRACK_MODEL=claude-sonnet-5-5       # any vision-capable Claude model
# MEALTRACK_BACKEND=claude                # "mock" gives fake data and uses a separate demo database
# MEALTRACK_GOAL_KCAL=2000
# MEALTRACK_GOAL_WATER_ML=2000
# MEALTRACK_HOME=.mealtrack               # where the log and the cache live
# MEALTRACK_DB=.mealtrack/log.db          # overrides the log location for every backend
# MEALTRACK_CACHE_DIR=.mealtrack/cache
